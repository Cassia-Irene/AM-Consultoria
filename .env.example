# =============================================================================
# AM Consultoria — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# =============================================================================


# =============================================================================
# BANCO DE DADOS
# =============================================================================
# DATABASE_URL tem PRIORIDADE sobre as variáveis individuais abaixo.
# Use UM dos formatos abaixo, dependendo do ambiente:

# ── Desenvolvimento local (Docker Compose incluído no projeto) ────────────────
DATABASE_URL=postgresql://admin:admin123@localhost:5432/am_consultoria

# ── Produção (Neon) ───────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://neondb_owner:SENHA@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ── Variáveis individuais (usadas como FALLBACK se DATABASE_URL não estiver definida) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=am_consultoria
DB_USER=admin
DB_PASSWORD=admin123


# =============================================================================
# AMBIENTE
# =============================================================================
# Valores: development | production
ENVIRONMENT=development


# =============================================================================
# CORS — Backend FastAPI
# =============================================================================
# Lista de origens permitidas, separadas por vírgula.
# Desenvolvimento local:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Produção: adicione a URL da Vercel
# CORS_ORIGINS=https://meu-app.vercel.app


# =============================================================================
# FRONTEND — Next.js
# =============================================================================
# Desabilita mocks e aponta para a API local
NEXT_PUBLIC_USE_MOCK=false

# Desenvolvimento local:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Produção (Vercel): configure esta variável no painel da Vercel
# NEXT_PUBLIC_API_URL=https://meu-backend.onrender.com