# =============================================================================
# AM Consultoria — Frontend (Next.js)
# Variáveis de Ambiente Locais
# =============================================================================
# Copie este arquivo para .env.local:
#   cp .env.local.example .env.local
#
# .env.local está no .gitignore — não commite valores reais.
# =============================================================================

# Desabilita mocks (usa a API real)
NEXT_PUBLIC_USE_MOCK=false

# URL da API backend
# Desenvolvimento local:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Produção (configurar no painel da Vercel, não aqui):
# NEXT_PUBLIC_API_URL=https://meu-backend.onrender.com
